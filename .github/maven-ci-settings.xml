<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI only (passed with -s in .github/workflows/verify.yml). Adds Google's mirror of Maven Central as
  a second repository: Maven asks Central first and falls back to the next repository when an
  artifact is missing. Hosted runners are sometimes refused by Central for minutes at a time
  (PR #4, PR #6), which retries alone did not survive. Same artifacts, same checksums.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>central-fallback</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-fallback</activeProfile>
  </activeProfiles>
</settings>
